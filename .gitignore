# ==============================================================================
#  E:\FPGA 工作区根 .gitignore
#
#  原则：只版本化「人写的、体积小的、需要 diff 的」内容。
#        厂商安装包 / 可重建的编译产物 / 大体积二进制 一律排除。
#
#  实测依据（2026-10-12）：
#    全树 13175 文件 / 8106.5 MB
#    ├─ 官方资料/                 7092.1 MB  ← 占 87%（TD 安装包 1.95 GB、ModelSim 1.21 GB、教学视频 890 MB）
#    ├─ anlogic_example/           277.8 MB  ← 安路官方例程，厂商资料
#    ├─ _analysis/                 228.7 MB  ← 其中 out/ 82.5 MB、sim/**/work/ 132 MB 是产物
#    ├─ proj/                      206.8 MB  ← 其中 _Runs/ 的 .db/.bit/.timing 是产物
#    ├─ captures/                   95.5 MB  ← 采集照片，保留（队友要看得见画面）
#    └─ 其余（tools/ raw_exports/ doc/ MOVE_INDEX.md）  ~4 MB
#
#  Gitee 社区版配额：单仓库 500 MB / 单文件 50 MB / 总 5 GB
# ==============================================================================

# ---------- 1. 安路官方资料（厂商安装包与视频，7.1 GB）----------
/官方资料/
/anlogic_example/
/.extract/
/proj.zip

# ---------- 2. 本地安全网与历史归档（不进版本库）----------
/_backup/
/_archive/
/.idea/
/Thumbs.db
/desktop.ini

# ---------- 3. 分析产物（脚本可重生成）----------
/_analysis/out/
/_analysis/tmp/
/_analysis/**/work/
_analysis/hdlbase/
_analysis/hdlbase2/
*.qpg
*.qtl
*.qdb
_vsim.log
vsim.wlf
transcript
*_vmake.rpt

# ---------- 4. TD / 综合布线产物 ----------
**/camera_to_dsi_display_Runs/
**/camera_to_dsi_display.prj
**/.IpToolIpDataBackupDir_*/
**/log/
*.bit
*.bid
*.bin
*.aje
*.svf
*.db
*.ddb
*.area
*.qor
*.timing
*.timingsummary
*.ts
*.pack
*.rpt
flow.status
*.step.begin.f
*.step.end.f
*.step.error.f
*.lock.f
*.temp.f

# ---------- 5. 大体积二进制 ----------
*.zip
*.7z
*.rar
*.exe
*.msi
*.iso
*.mp4
*.mp3
*.wav
*.pdf

# ---------- 6. 旧版备份文件 ----------
*.bak
*.bak_*
*.orig

# ---------- 7. 例外：里程碑交付物必须手动归档，允许入库 ----------
#   用法： releases/<日期>_<版本>/camera_to_dsi_display.bit + NOTE.md
!/releases/**
!/releases/**/*.bit

# ---------- 8. Windows / 编辑器 ----------
Thumbs.db
desktop.ini
*.swp
*~
